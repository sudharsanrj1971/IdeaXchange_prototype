# Mongo connection string (Atlas or local)
MONGODB_URI=mongodb://localhost:27017/ideaxchange

# Base64-encoded Firebase service account JSON
# (echo '<contents of key.json>' | base64)
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Required by src/config/envValidator.js — generate with e.g.
# `openssl rand -hex 32`
JWT_SECRET=
PLATFORM_SIGNING_KEY=
RAFT_INTERNAL_SECRET=

# Frontend origin(s) allowed to make credentialed requests, comma-separated
# for more than one (e.g. a Vercel preview URL + production URL)
CORS_ORIGIN=http://localhost:5173

# Port the server listens on. Most platforms (Render, Heroku, Railway)
# inject this themselves — set it here only for local/manual runs.
PORT=5000

# Optional
BCRYPT_SALT_ROUNDS=12
ACCESS_TOKEN_TTL=15m
REDIS_URL=redis://localhost:6379
SENTRY_DSN=
